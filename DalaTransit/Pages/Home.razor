@page "/"
@using System.Net.Http.Json
@using DalaTransit.Domain
@inject HttpClient Http
@inject ResRobotRoutingService RoutingService
@inject HttpClient Http
@inject ResRobotRoutingService RoutingService
@inject IJSRuntime JS

<PageTitle>Dalatrafik – Reseplanerare med Bytesrisk</PageTitle>

<!-- Dalatrafik Header -->
<header class="dt-navbar">
    <div style="max-width: 1100px; margin: 0 auto; width: 100%; display: flex; justify-content: space-between; align-items: center;">
        <a href="/" class="dt-logo">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4 16c0 .88.39 1.67 1 2.22V20c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h8v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1.78c.61-.55 1-1.34 1-2.22V6c0-3.5-3.58-4-8-4s-8 .5-8 4v10zm3.5 1c-.83 0-1.5-.67-1.5-1.5S6.67 14 7.5 14s1.5.67 1.5 1.5S8.33 17 7.5 17zm9 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm1.5-6H6V6h12v5z" />
            </svg>
            <span>DALATRAFIK</span>
        </a>
        <nav class="dt-nav-links">
            <a href="#analys">Reseplanerare</a>
            <a href="#trafiklaget">Trafikläget</a>
            <a href="om">Om DalaTransit</a>
        </nav>
    </div>
</header>

<!-- Hero med utökad sökmodul -->
<section class="dt-hero">
    <h1 class="dt-hero-title">Hej, vart vill du resa?</h1>

    <div class="dt-search-card">
        <!-- Rad 1: Från / Till -->
        <div class="dt-input-group">
            <div class="dt-field">
                <label>Från</label>
                <input type="text" @bind="originStop" list="popularStops" placeholder="T.ex. Hellbergs väg" />
            </div>
            <button class="dt-swap-btn" type="button" title="Växla hållplatser" @onclick="SwapStops">⇄</button>
            <div class="dt-field">
                <label>Till</label>
                <input type="text" @bind="destinationStop" list="popularStops" placeholder="T.ex. Borlänge centrum" />
            </div>
        </div>

        <!-- Rad 2: Datum & Tid -->
        <div class="dt-input-group" style="margin-top: 0.75rem;">
            <div class="dt-field">
                <label>Datum</label>
                <input type="date" @bind="selectedDate" />
            </div>
            <div class="dt-field">
                <label>Avgångstid</label>
                <input type="time" @bind="selectedTime" />
            </div>
        </div>

        <datalist id="popularStops">
            <option value="Hellbergs väg">Hellbergs väg</option>
            <option value="Borlänge centrum">Borlänge centrum</option>
            <option value="Falun Knutpunkten">Falun Knutpunkten</option>
            <option value="Rättviks station">Rättviks station</option>
            <option value="Leksands station">Leksands station</option>
            <option value="Mora resecentrum">Mora resecentrum</option>
            <option value="Ludvika station">Ludvika station</option>
            <option value="Hedemora Centrumrondellen">Hedemora Centrumrondellen</option>
        </datalist>

        <!-- Rad 3: Senaste sökningar (centrerat under inmatningsfälten) -->
        @if (recentSearches.Count > 0)
        {
            <div style="display: flex; gap: 6px; flex-wrap: wrap; align-items: center; justify-content: center; margin-top: 1rem;">
                <span style="font-size: 0.8rem; color: #666;">Senaste:</span>
                @foreach (var s in recentSearches)
                {
                    <button type="button" class="dt-recent-chip" @onclick="() => SelectRecentSearch(s.From, s.To)">
                        @s.From ➔ @s.To
                    </button>
                }
            </div>
        }

        <!-- Rad 4: Endast EN centrerad sökknapp -->
        <div style="text-align: center; margin-top: 1.25rem;">
            <button class="dt-btn-primary" type="button" @onclick="SearchJourneys" disabled="@isSearching">
                @(isSearching ? "Hämtar tidtabeller..." : "Sök resa")
            </button>
        </div>
    </div>
</section>

<!-- Reseresultat med riskmätare -->
@if (isSearching)
{
    <div style="text-align: center; margin: 3rem 0; font-size: 1.1rem; color: #666;">
        Söker linjer och beräknar bytesrisker via Trafiklab ResRobot...
    </div>
}
else if (searchErrorMessage != null)
{
    <div style="max-width: 900px; margin: 2rem auto; padding: 1rem; background: #fff3cd; border-radius: 6px; text-align: center; color: #856404;">
        @searchErrorMessage
    </div>
}
else if (journeys.Count > 0)
{
    <section class="dt-journey-list">
        <div class="dt-date-header">
            @selectedDate.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("sv-SE"))
        </div>

        @foreach (var journey in journeys)
        {
            var isExpanded = expandedJourneyId == journey.Id;
            var risk = journey.RiskAnalysis;
            var onTimeRate = risk != null ? (100.0 - risk.MissRiskPercentage) : 100.0;
            var gaugeCss = GetGaugeClass(risk?.Category ?? RiskCategory.Low);

            <div class="dt-journey-card">
                <div class="dt-journey-summary" @onclick="() => ToggleDetails(journey.Id)">
                    <div class="dt-journey-time">
                        <span class="ca-prefix">ca</span> @journey.StartTime.ToString(@"hh\:mm") - @journey.EndTime.ToString(@"hh\:mm")
                    </div>

                    <div class="dt-journey-duration">
                        @($"{(int)journey.TotalDuration.TotalHours}:{(int)journey.TotalDuration.Minutes:D2}")
                    </div>

                    <div class="dt-journey-transfers">
                        @(journey.TransferCount == 0 ? "Direkt" : $"{journey.TransferCount} byte")
                    </div>

                    <div class="dt-journey-lines">
                        @foreach (var leg in journey.Legs)
                        {
                            <span class="dt-line-badge">@leg.LineNumber</span>
                        }
                    </div>

                    <!-- Visuell Riskmätare -->
                    <div class="dt-risk-gauge-container @gaugeCss">
                        <div class="dt-risk-status-text">
                            @if (journey.TransferCount > 0 && risk != null)
                            {
                                @($"{onTimeRate:F0}% chans att hinna")
                            }
                            else
                            {
                                <span>100% pålitlig</span>
                            }
                        </div>
                        <div class="dt-gauge-bar-bg" title="Statistisk sannolikhet baserad på historiska observationer">
                            <div class="dt-gauge-bar-fill" style="width: @(onTimeRate)%;"></div>
                        </div>
                    </div>

                    <div class="dt-toggle-details">
                        <span>Visa resedetaljer</span>
                        <span>@(isExpanded ? "−" : "+")</span>
                    </div>
                </div>

                @if (isExpanded)
                {
                    <div class="dt-journey-details">
                        @for (int i = 0; i < journey.Legs.Count; i++)
                        {
                            var leg = journey.Legs[i];

                                <div class="dt-leg-row">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <span class="dt-line-badge" style="background-color: #004b87;">@leg.LineNumber</span>
                                        <strong>Linje @leg.LineNumber</strong>
                                        <span style="color: #666; font-size: 0.85rem;">(@leg.DepartureTime.ToString(@"hh\:mm") – @leg.ArrivalTime.ToString(@"hh\:mm"))</span>
                                    </div>

                                    <div style="margin-top: 6px; margin-left: 63px;">
                                        <span>Vid <strong>@leg.OriginStop</strong> @leg.OriginPlatform tar du Linje @leg.LineNumber mot @leg.DirectionHeading.</span>
                                    </div>
                                    <div style="margin-top: 6px; color: #666; margin-left: 63px;">
                                        <span>Gå av vid <strong>@leg.DestinationStop</strong> @leg.DestinationPlatform kl @leg.ArrivalTime.ToString(@"hh\:mm").</span>
                                    </div>
                                </div>

                                @if (i < journey.Legs.Count - 1)
                                {
                                    var nextLeg = journey.Legs[i + 1];
                                    var margin = (int)(nextLeg.DepartureTime >= leg.ArrivalTime
                                        ? (nextLeg.DepartureTime - leg.ArrivalTime).TotalMinutes
                                        : (nextLeg.DepartureTime + TimeSpan.FromHours(24) - leg.ArrivalTime).TotalMinutes);

                                    var hourStart = leg.ArrivalTime.Hours;
                                    var intervalText = $"{hourStart:D2}:00–{(hourStart + 1) % 24:D2}:00";
                                    var isRushHour = hourStart is 7 or 8 or 15 or 16;

                                    <div class="dt-transfer-alert" style="border-left-color: @(margin <= 3 ? "#c80032" : "#2e7d32"); background-color: @(margin <= 3 ? "#fdeded" : "#edf7ed");">
                                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 4px;">
                                            <span style="font-weight: 700; color: #111;">
                                                Byte vid @leg.DestinationStop: @margin minuters marginal (@leg.DestinationPlatform ➔ @nextLeg.OriginPlatform)
                                            </span>
                                            <span style="font-size: 0.75rem; background: rgba(0,0,0,0.06); padding: 2px 8px; border-radius: 10px; font-weight: 600;">
                                                Trafikintervall: @intervalText @(isRushHour ? "(Rusningstid)" : "")
                                            </span>
                                        </div>
                                        <div style="font-size: 0.85rem; color: #444; margin-top: 5px;">
                                            @if (margin <= 3)
                                            {
                                                <span style="color: #c80032; font-weight: bold;">Snävt byte:</span>
                                                if (isRushHour)
                                                {
                                                    <span> Förhöjd risk under rusningstrafik. P90-förseningen (@(journey.RiskAnalysis?.P90DelayMinutes ?? 6.2) min) överstiger marginalen kraftigt.</span>
                                                }
                                                else
                                                {
                                                    <span> P90-förseningen överstiger marginalen. Risk att anslutande buss hinner avgå.</span>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color: #2e7d32; font-weight: bold;">Tryggt byte:</span>
                                                <span> Marginalen ger god säkerhet mot normala förseningar under intervallet @intervalText.</span>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    
                }
            </div>
        }
    </section>
}

@code {
    private string originStop = "Hellbergs väg";
    private string destinationStop = "Borlänge centrum";
    private DateOnly selectedDate = DateOnly.FromDateTime(DateTime.Today);
    private TimeOnly selectedTime = TimeOnly.FromDateTime(DateTime.Now);

    private string? expandedJourneyId;
    private bool isSearching = false;
    private string? searchErrorMessage;

    private RiskExportData? riskData;
    private List<JourneyOption> journeys = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            riskData = await Http.GetFromJsonAsync<RiskExportData>($"data/risk-reports.json?v={DateTime.UtcNow.Ticks}");
        }
        catch { }

        await SearchJourneys();
    }

    private async Task SwapStops()
    {
        (originStop, destinationStop) = (destinationStop, originStop);
        await SearchJourneys();
    }

    private void ToggleDetails(string id)
    {
        expandedJourneyId = (expandedJourneyId == id) ? null : id;
    }

    private async Task SearchJourneys()
    {
        if (string.IsNullOrWhiteSpace(originStop) || string.IsNullOrWhiteSpace(destinationStop))
            return;

        isSearching = true;
        searchErrorMessage = null;
        journeys.Clear();

        try
        {
            var travelDateTime = selectedDate.ToDateTime(selectedTime);
            journeys = await RoutingService.SearchTripsAsync(originStop, destinationStop, travelDateTime, riskData);

            if (journeys.Count > 0)
            {
                await SaveRecentSearchAsync(originStop, destinationStop);
            }
            else
            {
                searchErrorMessage = $"Kunde inte hitta några resor mellan '{originStop}' och '{destinationStop}' för valt datum och tid.";
            }
        }
        catch (Exception ex)
        {
            searchErrorMessage = $"Ett fel uppstod vid hämtning av resor: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private string GetGaugeClass(RiskCategory category) => category switch
    {
        RiskCategory.Low => "dt-gauge-low",
        RiskCategory.Moderate => "dt-gauge-moderate",
        _ => "dt-gauge-critical"
    };

    private record RecentRoute(string From, string To);
    private List<RecentRoute> recentSearches = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRecentSearchesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadRecentSearchesAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "dt_recent_searches");
            if (!string.IsNullOrWhiteSpace(json))
            {
                var loaded = System.Text.Json.JsonSerializer.Deserialize<List<RecentRoute>>(json);
                if (loaded != null)
                {
                    recentSearches = loaded;
                }
            }
        }
        catch { }
    }

    private async Task SaveRecentSearchAsync(string from, string to)
    {
        try
        {
            recentSearches.RemoveAll(r =>
                string.Equals(r.From, from, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(r.To, to, StringComparison.OrdinalIgnoreCase));

            recentSearches.Insert(0, new RecentRoute(from, to));

            if (recentSearches.Count > 4)
            {
                recentSearches = recentSearches.Take(4).ToList();
            }

            var json = System.Text.Json.JsonSerializer.Serialize(recentSearches);
            await JS.InvokeVoidAsync("localStorage.setItem", "dt_recent_searches", json);
        }
        catch { }
    }

    private async Task SelectRecentSearch(string from, string to)
    {
        originStop = from;
        destinationStop = to;
        await SearchJourneys();
    }
}